#include <windows.h>
#include "version.h"

// Манифест: asInvoker + PerMonitorV2 DPI.
1 24 "app.manifest"

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    RDPKEY_VER_NUM
 PRODUCTVERSION RDPKEY_VER_NUM
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "rdpkey"
            VALUE "FileDescription",  "RDP RemoteApp hotkey forwarder"
            VALUE "FileVersion",      RDPKEY_VER_STR
            VALUE "InternalName",     "rdpkey"
            VALUE "LegalCopyright",    "MIT License"
            VALUE "OriginalFilename", "rdpkey.exe"
            VALUE "ProductName",      "RDP RemoteApp Hotkeys"
            VALUE "ProductVersion",   RDPKEY_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
